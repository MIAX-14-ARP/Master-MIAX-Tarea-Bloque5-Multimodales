# FinLens - configuración. Copia este fichero a .env (cp .env.example .env).
# Sin claves, o con DEMO_MODE=true, la app arranca en MODO DEMO con respuestas simuladas.
# NO subas nunca el fichero .env al repositorio.

# --- Modo demo -------------------------------------------------------------
DEMO_MODE=false

# --- Claves API ------------------------------------------------------------
# Una sola clave de OpenRouter cubre las 5 capacidades (LLM, visión, STT, TTS, imagen).
# Alternativa: ANTHROPIC_API_KEY (llm/visión) y OPENAI_API_KEY (stt/tts/imagen).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Proveedor por capacidad -----------------------------------------------
# auto | openrouter | anthropic | openai | mock
# auto = OpenRouter si hay OPENROUTER_API_KEY; si no, el nativo (anthropic para llm/visión,
# openai para stt/tts/imagen) si hay su clave; si no, mock (simulado).
# Pedir un proveedor sin clave deja esa capacidad en mock y se avisa.
LLM_PROVIDER=auto
VISION_PROVIDER=auto
STT_PROVIDER=auto
TTS_PROVIDER=auto
IMAGE_PROVIDER=auto
# Embeddings (recuperación semántica): auto | openrouter | openai | mock
EMBEDDINGS_PROVIDER=auto

# --- Modelos de OpenRouter (slugs del catálogo https://openrouter.ai/api/v1/models) ---
# VERIFICAR: los modelos cambian y se retiran con el tiempo.
OPENROUTER_LLM_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
OPENROUTER_TTS_VOICE=ef_dora
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
# Embeddings multilingües (1024 dims): permiten preguntar en español sobre informes en inglés.
OPENROUTER_EMBEDDINGS_MODEL=baai/bge-m3
# Si la transcripción sale truncada se reintenta una vez con este modelo (vacío = sin respaldo).
OPENROUTER_STT_FALLBACK_MODEL=openai/gpt-4o-mini-transcribe
# Idioma de la transcripción (ISO-639-1, p.ej. es); vacío = autodetección.
STT_LANGUAGE=
# Algunos modelos de OpenRouter razonan siempre y esos tokens cuentan contra max_tokens:
# esfuerzo enviado (low|medium|high|...; vacío = no enviarlo) y mínimo de max_tokens.
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_MIN_OUTPUT_TOKENS=4000

# --- Nombres de modelo de los proveedores nativos --------------------------
# VERIFICAR en la documentación oficial de cada proveedor antes de usar.
LLM_MODEL=claude-sonnet-5-5
VISION_MODEL=claude-sonnet-5-5
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
IMAGE_MODEL=gpt-image-1
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Ajustes de las llamadas reales ----------------------------------------
# Esfuerzo de razonamiento del LLM: low | medium | high | xhigh | max (vacío = no enviarlo).
LLM_EFFORT=medium
# true = si Anthropic rechaza una petición, se reintenta en otro modelo (API beta).
LLM_REFUSAL_FALLBACK=false
# Mínimo de max_tokens enviado a Anthropic NATIVO: allí el pensamiento comparte presupuesto con la
# respuesta y un límite bajo corta el JSON. No se aplica a OpenRouter.
LLM_MIN_OUTPUT_TOKENS=4000
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium

# Nivel de logging (DEBUG|INFO|WARNING|ERROR). Nunca se registran documentos ni claves.
LOG_LEVEL=INFO

# --- Límites de entrada ----------------------------------------------------
# Máximo de caracteres de texto que se ingieren del PDF (controla el coste).
MAX_PDF_CHARS=300000

# --- Tarifas orientativas (USD) --------------------------------------------
# Con OpenRouter se usa el coste real que informa la API; estas tarifas se usan si no lo informa.
# VERIFICAR en las páginas oficiales de precios antes de citar cifras en el README.
# Son valores de referencia para estimar el coste; no están contrastados
# con los modelos configurados arriba.
PRICE_LLM_INPUT_PER_MTOK=2.0
PRICE_LLM_OUTPUT_PER_MTOK=10.0
PRICE_STT_PER_MINUTE=0.006
PRICE_TTS_PER_MCHAR=15.0
PRICE_IMAGE_PER_UNIT=0.04
PRICE_EMBEDDINGS_PER_MTOK=0.02
# TTS vía OpenRouter (no informa del coste): hexgrad/kokoro-82m según su catálogo. VERIFICAR.
OPENROUTER_PRICE_TTS_PER_MCHAR=0.62
