# FinLens - configuración. Copia este fichero a .env (cp .env.example .env).
# Sin claves, o con DEMO_MODE=true, la app arranca en MODO DEMO con respuestas simuladas.
# NO subas nunca el fichero .env al repositorio.

# --- Modo demo -------------------------------------------------------------
DEMO_MODE=false

# --- Claves API ------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Nombres de modelo -----------------------------------------------------
# VERIFICAR en la documentación oficial de cada proveedor antes de usar:
# los nombres cambian y se retiran modelos con el tiempo.
LLM_MODEL=claude-sonnet-5-5
VISION_MODEL=claude-sonnet-5-5
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
IMAGE_MODEL=gpt-image-1

# --- Ajustes de las llamadas reales ----------------------------------------
# Esfuerzo de razonamiento del LLM: low | medium | high | xhigh | max (vacío = no enviarlo).
LLM_EFFORT=medium
# true = si Anthropic rechaza una petición, se reintenta en otro modelo (API beta).
LLM_REFUSAL_FALLBACK=false
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium

# --- Límites de entrada ----------------------------------------------------
# Máximo de caracteres de texto que se ingieren del PDF (controla el coste).
MAX_PDF_CHARS=300000

# --- Tarifas orientativas (USD) --------------------------------------------
# VERIFICAR en las páginas oficiales de precios antes de citar cifras en el README.
# Son valores de referencia para estimar el coste; no están contrastados
# con los modelos configurados arriba.
PRICE_LLM_INPUT_PER_MTOK=2.0
PRICE_LLM_OUTPUT_PER_MTOK=10.0
PRICE_STT_PER_MINUTE=0.006
PRICE_TTS_PER_MCHAR=15.0
PRICE_IMAGE_PER_UNIT=0.04
